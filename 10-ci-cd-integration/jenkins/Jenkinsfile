pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        APP_NAME = 'docker-ci-practice'
        DOCKERHUB_REPOSITORY = 'arulkumar27/docker-ci-practice'
        APP_DIRECTORY = '10-ci-cd-integration/sample-app'
        TEST_CONTAINER = 'jenkins-docker-ci-test'
        TEST_PORT = '8085'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    set -eu

                    docker version
                    docker info
                    test -f "${APP_DIRECTORY}/Dockerfile"
                    test -f "${APP_DIRECTORY}/index.html"
                '''
            }
        }

        stage('Generate Image Tag') {
            steps {
                script {
                    env.GIT_SHORT_COMMIT = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_REFERENCE =
                        "${env.DOCKERHUB_REPOSITORY}:sha-${env.GIT_SHORT_COMMIT}"
                }

                echo "Building image: ${env.IMAGE_REFERENCE}"
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      --pull \
                      --label "org.opencontainers.image.revision=${GIT_COMMIT}" \
                      --label "org.opencontainers.image.source=${GIT_URL}" \
                      --tag "${IMAGE_REFERENCE}" \
                      "${APP_DIRECTORY}"
                '''
            }
        }

        stage('Inspect Image') {
            steps {
                sh '''
                    set -eu

                    docker image inspect "${IMAGE_REFERENCE}"
                    docker image history "${IMAGE_REFERENCE}"
                '''
            }
        }

        stage('Container Smoke Test') {
            steps {
                sh '''
                    set -eu

                    docker rm -f "${TEST_CONTAINER}" >/dev/null 2>&1 || true

                    docker run -d \
                      --name "${TEST_CONTAINER}" \
                      --publish "127.0.0.1:${TEST_PORT}:80" \
                      --memory="256m" \
                      --cpus="0.50" \
                      --pids-limit=100 \
                      --security-opt=no-new-privileges:true \
                      "${IMAGE_REFERENCE}"

                    attempt=1

                    while [ "$attempt" -le 12 ]; do
                      if curl --fail --silent \
                        "http://127.0.0.1:${TEST_PORT}" \
                        | grep --quiet "Docker CI/CD Practice"; then
                        echo "Smoke test passed."
                        exit 0
                      fi

                      echo "Waiting for application: attempt ${attempt}/12"
                      attempt=$((attempt + 1))
                      sleep 5
                    done

                    echo "Smoke test failed."
                    docker logs "${TEST_CONTAINER}"
                    exit 1
                '''
            }
        }

        stage('Vulnerability Scan') {
            steps {
                sh '''
                    set -eu

                    docker run --rm \
                      --mount type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock,readonly \
                      aquasec/trivy:0.59.1 \
                      image \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 0 \
                      "${IMAGE_REFERENCE}"

                    docker run --rm \
                      --mount type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock,readonly \
                      aquasec/trivy:0.59.1 \
                      image \
                      --scanners vuln \
                      --severity CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      "${IMAGE_REFERENCE}"
                '''
            }
        }

        stage('Publish Image') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker push "${IMAGE_REFERENCE}"

                        docker tag \
                          "${IMAGE_REFERENCE}" \
                          "${DOCKERHUB_REPOSITORY}:latest"

                        docker push \
                          "${DOCKERHUB_REPOSITORY}:latest"

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker rm -f "${TEST_CONTAINER}" >/dev/null 2>&1 || true
                docker logout >/dev/null 2>&1 || true
            '''
        }

        success {
            echo "Docker CI pipeline completed successfully."
        }

        failure {
            echo "Docker CI pipeline failed. Review the failed stage and logs."
        }

        cleanup {
            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
